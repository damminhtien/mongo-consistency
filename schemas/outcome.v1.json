{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mongo-consistency/outcome.v1.json",
  "title": "Checked history outcome",
  "type": "object",
  "required": ["outcome", "reason", "details"],
  "properties": {
    "outcome": {
      "enum": ["PASS", "VIOLATION", "UNAVAILABLE", "INDETERMINATE", "PRECONDITION_MISS", "HARNESS_ERROR"]
    },
    "reason": {"type": "string", "minLength": 1},
    "details": {"type": "object"}
  },
  "additionalProperties": false
}
