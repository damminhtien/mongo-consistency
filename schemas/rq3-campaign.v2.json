{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mongo-consistency/rq3-campaign.v2.json",
  "title": "RQ3 protocol-v2 matched mechanism campaign manifest",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_id",
    "campaign",
    "status",
    "repetitions_per_contrast",
    "seed_base",
    "planned_case_count",
    "completed_case_count",
    "runner_commit",
    "runner_script_sha256",
    "configuration_sha256",
    "protocol_sha256",
    "topology_plan_sha256",
    "preflight_sha256",
    "anchor_manifest_sha256",
    "runtime_provenance",
    "contrasts",
    "pair_controls",
    "records",
    "started_ns",
    "last_updated_ns"
  ],
  "properties": {
    "schema_version": {"const": "rq3-campaign.v2"},
    "protocol_id": {"const": "rq3-protocol.v2"},
    "campaign": {"const": "rq3"},
    "status": {"enum": ["RUNNING", "COMPLETE", "INTERRUPTED", "FAILED"]},
    "repetitions_per_contrast": {"type": "integer", "minimum": 5, "maximum": 10},
    "seed_base": {"type": "integer", "minimum": 0},
    "planned_case_count": {"type": "integer", "minimum": 30, "maximum": 60},
    "completed_case_count": {"type": "integer", "minimum": 0, "maximum": 60},
    "runner_commit": {"type": ["string", "null"]},
    "runner_script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_sha256": {"type": ["string", "null"]},
    "topology_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preflight_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "anchor_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_provenance": {"type": "object"},
    "contrasts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["contrast_id", "mechanism", "left_configuration", "right_configuration", "property", "changed_factor", "capture_operations", "pair_ids"],
        "properties": {
          "contrast_id": {"enum": ["M1", "M2", "M3"]},
          "mechanism": {"type": "string", "minLength": 1},
          "left_configuration": {"pattern": "^C[1-8]$"},
          "right_configuration": {"pattern": "^C[1-8]$"},
          "property": {"enum": ["RYW", "MR", "MW", "WFR"]},
          "changed_factor": {"type": "string", "minLength": 1},
          "capture_operations": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "pair_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "pair_controls": {
      "type": "array",
      "minItems": 15,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["contrast_id", "pair_id", "pair_seed", "desired", "observed", "control_valid", "invalid_reasons"],
        "properties": {
          "contrast_id": {"enum": ["M1", "M2", "M3"]},
          "pair_id": {"type": "string", "pattern": "^m[1-3]-r[0-9]{2}$"},
          "pair_seed": {"type": ["integer", "null"], "minimum": 0},
          "desired": {
            "type": "object",
            "required": ["initial_primary", "isolation_target", "expected_new_primary", "subject_read_member", "first_write_member", "second_write_member", "election_guard_member", "routes"],
            "properties": {
              "initial_primary": {"enum": ["mongo1", "mongo2", "mongo3"]},
              "isolation_target": {"enum": ["mongo1", "mongo2", "mongo3"]},
              "expected_new_primary": {"enum": ["mongo1", "mongo2", "mongo3", null]},
              "subject_read_member": {"enum": ["mongo1", "mongo2", "mongo3", null]},
              "first_write_member": {"enum": ["mongo1", "mongo2", "mongo3", null]},
              "second_write_member": {"enum": ["mongo1", "mongo2", "mongo3", null]},
              "election_guard_member": {"enum": ["mongo1", "mongo2", "mongo3", null]},
              "routes": {"type": "object", "minProperties": 1, "additionalProperties": {"enum": ["mongo1", "mongo2", "mongo3"]}}
            },
            "additionalProperties": false
          },
          "observed": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 2,
            "patternProperties": {
              "^C[1-8]$": {
                "type": "object",
                "required": ["present", "invalid_reasons"],
                "properties": {
                  "present": {"type": "boolean"},
                  "observed": {"type": "object"},
                  "invalid_reasons": {"type": "array", "items": {"type": "string"}}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "control_valid": {"type": "boolean"},
          "invalid_reasons": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trial_id", "ordinal", "campaign", "configuration_id", "property", "seed", "path", "history_hash", "outcome", "precondition_status", "runner_commit", "runner_error", "contrast_id", "pair_id", "replicate", "pair_seed"],
        "properties": {
          "trial_id": {"type": "string", "minLength": 1},
          "ordinal": {"type": "integer", "minimum": 1},
          "campaign": {"enum": ["rq3-m1", "rq3-m2", "rq3-m3"]},
          "configuration_id": {"pattern": "^C[1-8]$"},
          "property": {"enum": ["RYW", "MR", "MW", "WFR"]},
          "seed": {"type": "integer", "minimum": 0},
          "path": {"type": "string", "minLength": 1},
          "history_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "outcome": {"enum": ["PASS", "VIOLATION", "UNAVAILABLE", "INDETERMINATE", "PRECONDITION_MISS", "HARNESS_ERROR"]},
          "precondition_status": {"enum": ["SATISFIED", "PRECONDITION_MISS"]},
          "runner_commit": {"type": ["string", "null"]},
          "runner_error": {"type": ["string", "null"]},
          "contrast_id": {"enum": ["M1", "M2", "M3"]},
          "pair_id": {"type": "string", "minLength": 1},
          "replicate": {"type": "integer", "minimum": 1},
          "pair_seed": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    "started_ns": {"type": "integer", "minimum": 0},
    "last_updated_ns": {"type": "integer", "minimum": 0},
    "finished_ns": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
