{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mongo-consistency/operation.v1.json",
  "title": "MongoDB subject operation record",
  "type": "object",
  "required": ["operation_id", "kind", "key", "operation_status", "command_started", "response_received"],
  "properties": {
    "operation_id": {"type": "string", "minLength": 1},
    "trial_id": {"type": ["string", "null"]},
    "property": {"type": ["string", "null"]},
    "kind": {"enum": ["read", "write"]},
    "key": {"type": "string", "minLength": 1},
    "operation_status": {"enum": ["SUCCESS", "UNAVAILABLE", "INDETERMINATE", "HARNESS_ERROR"]},
    "requested_member": {"type": ["string", "null"]},
    "actual_server_address": {"type": ["string", "null"]},
    "actual_role": {"type": ["string", "null"]},
    "actual_role_observed_at_ns": {"type": ["integer", "null"], "minimum": 0},
    "driver_reported_role": {"type": ["string", "null"]},
    "command_name": {"type": ["string", "null"]},
    "command_started": {"type": "boolean"},
    "command_events": {"type": "array", "items": {"type": "object"}},
    "session_id": {"type": ["string", "null"]},
    "causal_session": {"type": ["boolean", "null"]},
    "read_concern": {"type": ["string", "null"]},
    "write_concern": {"type": ["string", "null"]},
    "start_ns": {"type": ["integer", "null"], "minimum": 0},
    "end_ns": {"type": ["integer", "null"], "minimum": 0},
    "error_code": {"type": ["string", "null"]},
    "error_message": {"type": ["string", "null"]},
    "timeout_category": {"type": ["string", "null"]},
    "fault_event_id": {"type": ["string", "null"]},
    "fault_state": {"type": "object"},
    "intended_version": {"type": ["integer", "null"], "minimum": 0},
    "write_base_version": {"type": ["integer", "null"], "minimum": 0},
    "write_base_observed": {"type": "boolean"},
    "write_base_write_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "write_id": {"type": ["string", "null"]},
    "observed_document_exists": {"type": ["boolean", "null"]},
    "observed_version": {"type": ["integer", "null"], "minimum": 0},
    "observed_versions": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "observed_write_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "observed_updates": {"type": "array", "items": {"type": "object"}},
    "parent_write_id": {"type": ["string", "null"]},
    "depends_on_read_id": {"type": ["string", "null"]},
    "depends_on_version": {"type": ["integer", "null"], "minimum": 0},
    "dependency_metadata": {"type": "object"},
    "cluster_time_before": {"type": ["object", "null"]},
    "operation_time_before": {"type": ["object", "null"]},
    "cluster_time_after": {"type": ["object", "null"]},
    "operation_time_after": {"type": ["object", "null"]},
    "after_cluster_time": {"type": ["object", "null"]},
    "topology_before": {"type": ["object", "null"]},
    "topology_after": {"type": ["object", "null"]},
    "response_received": {"type": "boolean"}
  },
  "additionalProperties": false
}
