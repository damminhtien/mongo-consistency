{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mongo-consistency/summary.v1.json",
  "title": "MongoDB consistency analysis summary",
  "type": "object",
  "required": ["schema_version", "status", "history_count", "outcome_counts", "campaign_summaries", "groups", "factorial", "predictions"],
  "properties": {
    "schema_version": {"const": "summary.v1"},
    "status": {"enum": ["DATA", "NO_DATA"]},
    "history_count": {"type": "integer", "minimum": 0},
    "outcome_counts": {
      "type": "object",
      "required": ["PASS", "VIOLATION", "UNAVAILABLE", "INDETERMINATE", "PRECONDITION_MISS", "HARNESS_ERROR"],
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "campaign_summaries": {
      "type": "object",
      "description": "Campaign-level aggregates; main control and adversarial groups remain separate from the pilot.",
      "additionalProperties": {
        "type": "object",
        "required": ["history_count", "outcomes", "overall", "normal", "adversarial", "properties"],
        "properties": {
          "history_count": {"type": "integer", "minimum": 0},
          "outcomes": {"type": "object"},
          "overall": {"type": "object"},
          "normal": {"type": "object"},
          "adversarial": {"type": "object"},
          "properties": {
            "type": "object",
            "additionalProperties": {"type": "object"}
          }
        }
      }
    },
    "groups": {"type": "array", "items": {"type": "object"}},
    "fault_episode_summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "topology_condition",
          "episode_count",
          "election_episode_count",
          "election_success_count",
          "election_failure_count",
          "election_ms",
          "recovery_episode_count",
          "recovery_ms",
          "recovery_status_counts",
          "episodes"
        ],
        "properties": {
          "topology_condition": {"enum": ["F1", "F2", "F3"]},
          "episode_count": {"type": "integer", "minimum": 0},
          "election_episode_count": {"type": "integer", "minimum": 0},
          "election_success_count": {"type": "integer", "minimum": 0},
          "election_failure_count": {"type": "integer", "minimum": 0},
          "election_ms": {"type": "object"},
          "recovery_episode_count": {"type": "integer", "minimum": 0},
          "recovery_ms": {"type": "object"},
          "recovery_status_counts": {"type": "object"},
          "episodes": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": true
      }
    },
    "factorial": {"type": "object"},
    "predictions": {"type": "object"}
  },
  "additionalProperties": true
}
